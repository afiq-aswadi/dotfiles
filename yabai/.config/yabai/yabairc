yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa
# default layout (can be bsp, stack or float)
yabai -m config layout bsp

#sketchybar implementation

yabai -m config external_bar all:$(sketchybar --query bar | jq .height):0

# trigger sketchybar updates on window events
yabai -m signal --add event=window_focused action="sketchybar --trigger window_focused"
yabai -m signal --add event=window_created action="sketchybar --trigger window_created"
yabai -m signal --add event=window_destroyed action="sketchybar --trigger window_destroyed"
yabai -m signal --add event=space_changed action="sketchybar --trigger space_change"

# auto-focus window under mouse when closing a window
# yabai -m signal --add event=window_destroyed action="yabai -m window --focus mouse"

#remove shadow

yabai -m config window_shadow float

# new window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# padding set to 12px
yabai -m config top_padding 6
yabai -m config bottom_padding 
yabai -m config left_padding 0
yabai -m config right_padding 0
yabai -m config window_gap 5


