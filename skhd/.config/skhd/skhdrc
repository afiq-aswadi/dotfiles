# opening software shortcuts
cmd - 0 : open -na 'Zen Browser'
cmd + shift - return : open -na 'ghostty'

# toggle flux
shift + alt - f : if pgrep -x "Flux" > /dev/null; then killall Flux; else open -a Flux; fi

# start 5-minute timer
shift + cmd - t : export SENDER=timer_start && /Users/afiqabdillah/.config/sketchybar/plugins/timer.sh &

# changing space
cmd - e : yabai -m space --toggle show-desktop
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9

ctrl - j : yabai -m space --focus prev
ctrl - k : yabai -m space --focus next
ctrl - p: yabai -m space --focus recent
