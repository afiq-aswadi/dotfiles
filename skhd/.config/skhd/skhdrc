#sticky and push to east

alt - z : yabai -m window --toggle sticky; yabai -m window --insert east

# Cycle stack
alt - tab : yabai -m window --focus stack.next || yabai -m window --focus stack.first; sketchybar --trigger window_focused
shift + alt - tab : yabai -m window --focus stack.prev || yabai -m window --focus stack.last; sketchybar --trigger window_focused

